# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings -> API).
#
# NEXT_PUBLIC_ variables are exposed to the browser. Only the anon/publishable
# key belongs here — never the service_role secret key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Stage 6: used only by src/lib/paystack.ts, called only from
# src/app/dashboard/refunds/actions.ts (an Owner-authenticated Server
# Action) to issue a real Paystack refund once an Owner has approved one
# in the BMS. Never exposed to the browser, never NEXT_PUBLIC_-prefixed.
# This is a separate key from the website project's PAYSTACK_SECRET_KEY --
# both point at the same Paystack account, kept in each app's own env
# because the two are separate Next.js deployments. If this is left unset,
# refunds must be completed manually (process the refund directly in the
# Paystack dashboard, then use "Record Manual Completion" in the BMS).
PAYSTACK_SECRET_KEY=sk_test_your_secret_key

# Unified login: staff sign in on the public website (/customer-login) and
# get redirected here already authenticated, instead of using a separate
# BMS login page. Optional, and only meaningful once a real custom domain
# is live for both this app and the website. Set to the shared root
# domain (e.g. ".gafbezenergies.com", leading dot) so the Supabase auth
# session cookie set by the website is also readable here on a
# staff.<domain> subdomain. MUST be set to the exact same value as the
# website repo's own NEXT_PUBLIC_AUTH_COOKIE_DOMAIN. Leave unset (as
# today) while testing on *.vercel.app URLs -- a shared cookie domain
# cannot work there anyway, since vercel.app is a public suffix, and
# leaving it unset is a safe no-op (plain host-only cookies, identical to
# current behaviour). This app's own /login page keeps working as a
# direct fallback either way.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Origin of the public website, used only to build the link inside
# password-reset emails sent from this app's own /login page (the
# "choose a new password" screen lives on the website, not here). Falls
# back to the production domain if unset, so this works today without
# any env var set. Only needs overriding on a staging/preview deploy that
# should link back to its own preview website instead of production.
NEXT_PUBLIC_WEBSITE_URL=https://www.gafbezenergies.com

# Server-only. Rate limits this app's own /login page (sign-in and
# password reset -- see src/lib/rateLimit.ts) so scripting thousands of
# attempts per minute against staff accounts isn't practical. The same
# Upstash Redis database used by the website repo's own rate limiting
# can back this too (its keys are namespaced separately). If either is
# unset, rate limiting is simply disabled (fails open) rather than
# breaking login for local dev.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional, local-testing only -- never set these in Vercel/production.
# Used only by scripts/verify-website-catalogue.mjs to sign in as a real
# admin and a real non-admin staff account so it can verify the website
# catalogue RLS policies actually block a non-admin from editing website
# details. Without these four set, the script skips just those two
# checks (reported, not silently dropped) and still runs everything
# anon-testable. Use a real staff account's own credentials from your
# Supabase project -- there's no separate "test user" concept.
BMS_TEST_ADMIN_EMAIL=admin@example.com
BMS_TEST_ADMIN_PASSWORD=the-admin-accounts-real-password
BMS_TEST_STAFF_EMAIL=staff@example.com
BMS_TEST_STAFF_PASSWORD=the-staff-accounts-real-password
